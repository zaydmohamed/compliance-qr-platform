NODE_ENV=development

PORT=5000

MONGODB_URI=mongodb://localhost:27017/compliance-qr

JWT_SECRET=replace_with_secure_random_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_secure_random_64_char_hex_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3d

FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://192.168.1.25:5173

DEFAULT_USER_PASSWORD=Compliance@2026

# Tabaarak SMS Gateway Integration (https://sms.tabaarak.com)
TABAARAK_SMS_NAME=your_tabaarak_username
TABAARAK_SMS_PASSWORD=your_tabaarak_password
TABAARAK_SMS_BASE_URL=https://sms.tabaarak.com


# AI Chatbot Integration (Google AI Studio Key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy_your_google_ai_studio_api_key_here

# SMTP Email Configuration (Password Reset OTPs & Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Compliance QR <support@complianceqr.com>"

APP_TIMEZONE=Africa/Mogadishu

# Initial Super Admin Seed (Auto-generated if not existing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_FULLNAME=Platform Admin

# Cloudinary Cloud Image Storage (https://cloudinary.com - Free tier)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

